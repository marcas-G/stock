# ===== 单仓单树 .gitignore =====
# 根白名单：只放行三棵树与根级文件；本地大目录（data/ 392G、_archive/、projects/）永不被跟踪。
/*
!/README.md
!/CLAUDE.md
!/AGENTS.md
!/Makefile
!/.gitignore
!/docs/
!/scripts/
!/platform/
!/research/
!/.claude/

# 平台/研究运行时数据与产物（防御性显式声明）
data/
results/
*.duckdb

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
dist/
build/
.coverage
.coverage.*
htmlcov/

# 框架与工具目录
/superpowers/
/.agents/
/.worktrees/
/.claude/settings.local.json
